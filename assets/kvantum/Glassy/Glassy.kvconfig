[%General]
author=Glassy contributors
comment=Reusable palette-driven frosted surfaces
composite=true
translucent_windows=true
blurring=true
popup_blurring=true
reduce_window_opacity=50
reduce_menu_opacity=25
respect_DE=true
no_window_pattern=true
menu_shadow_depth=6
tooltip_shadow_depth=4
animate_states=false
attach_active_tab=false
joined_inactive_tabs=false
group_toolbar_buttons=false
remove_extra_frames=true
scroll_width=10
scroll_arrows=false
scroll_min_extent=32
slider_handle_width=18
slider_handle_length=18
check_size=16
layout_spacing=6
combo_as_lineedit=true
combo_menu=true
inline_spin_indicators=true
inline_spin_separator=false
slider_width=4
spread_progressbar=true
progressbar_thickness=6
left_tabs=true
submenu_overlap=0
x11drag=menubar_and_primary_toolbar

[Hacks]
transparent_dolphin_view=true
transparent_ktitle_label=true
transparent_menutitle=true
blur_translucent=true
disabled_icon_opacity=100
no_selection_tint=true

# Colors are omitted for Qt palette fallback. appearance.py adds only Base and
# AlternateBase to work around Kvantum 1.1.8's white/derived startup defaults.
[Window]
interior=false
frame=false
[WindowTranslucent]
interior=false
frame=false
[Dialog]
interior=false
frame=false
[DialogTranslucent]
interior=false
frame=false
[Toolbar]
interior=false
frame=false
[MenuBar]
interior=false
frame=false
[TabFrame]
interior=false
frame=false
[GenericFrame]
interior=false
frame=false
[Dock]
interior=false
frame=false

[PanelButtonCommand]
frame.expansion=0
frame=true
frame.element=button
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
frame.patternsize=0
focusFrame=true
interior=true
interior.element=button
text.margin=true
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
min_height=1.6font
text.shadow=false
indicator.element=arrow
indicator.size=12
[PanelButtonTool]
inherits=PanelButtonCommand
[ToolbarButton]
inherits=PanelButtonCommand
frame.element=button
interior.element=button
[LineEdit]
inherits=PanelButtonCommand
frame.element=input
interior.element=input
[ComboBox]
inherits=PanelButtonCommand
indicator.element=arrow-down
indicator.size=12
[IndicatorSpinBox]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=12
[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down
[IndicatorArrow]
indicator.element=arrow
indicator.size=12
[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
indicator.size=12
[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.element=arrow
[GroupBox]
inherits=PanelButtonCommand
frame.element=group
interior=false
[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
[MenuItem]
inherits=PanelButtonCommand
frame.element=selection
interior.element=selection
text.margin.top=1
text.margin.bottom=1
min_height=1font
[MenuBarItem]
inherits=MenuItem
[ToolTip]
inherits=Menu
[ItemView]
inherits=MenuItem
text.margin.left=4
text.margin.right=4
[CheckBox]
frame=false
interior=true
interior.element=check
text.margin=true
text.margin.left=4
[RadioButton]
inherits=CheckBox
interior.element=radio
[Focus]
frame=true
frame.element=focus
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.patternsize=0
interior=false
[TreeExpander]
frame=false
interior=false
indicator.element=tree
indicator.size=12
[ScrollbarGroove]
frame=false
interior=false
[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scroll
interior.element=scroll
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
indicator.size=0
[Slider]
inherits=PanelButtonCommand
frame.element=groove
interior.element=groove
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
[SliderCursor]
frame=false
interior=true
interior.element=handle
[Progressbar]
inherits=Slider
text.margin=false
[ProgressbarContents]
inherits=Slider
frame.element=progress
interior.element=progress
[SizeGrip]
frame=false
interior=false
indicator.element=grip
indicator.size=12
